[sub_resource type="BTAction" id="BTAction_idle"]
custom_name = "Idle outside awareness range"
script = ExtResource("6_idle")

[sub_resource type="BTSelector" id="BTSelector_root"]
custom_name = "Final Enemy"
children = [SubResource("BTSequence_reaction"), SubResource("BTSequence_attack"), SubResource("BTAction_idle")]

[resource]
