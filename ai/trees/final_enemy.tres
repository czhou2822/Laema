[gd_resource type="BehaviorTree" load_steps=16 format=3]

[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_can_engage.gd" id="1_engage"]
[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_approach.gd" id="2_approach"]
[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_windup.gd" id="3_windup"]
[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_strike.gd" id="4_strike"]
[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_recover.gd" id="5_recover"]
[ext_resource type="Script" path="res://ai/tasks/enemy/enemy_idle.gd" id="6_idle"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_ai"]
var/target/name = &"target"
var/target/type = 24
var/target/value = null
var/aggro_range/name = &"aggro_range"
var/aggro_range/type = 3
var/aggro_range/value = 600.0
var/attack_range/name = &"attack_range"
var/attack_range/type = 3
var/attack_range/value = 72.0
var/movement_speed/name = &"movement_speed"
var/movement_speed/type = 3
var/movement_speed/value = 90.0
var/windup_duration/name = &"windup_duration"
var/windup_duration/type = 3
var/windup_duration/value = 0.6
var/recovery_duration/name = &"recovery_duration"
var/recovery_duration/type = 3
var/recovery_duration/value = 0.9
var/damage/name = &"damage"
var/damage/type = 3
var/damage/value = 10.0
var/impact/name = &"impact"
var/impact/type = 2
var/impact/value = 1
var/phase/name = &"phase"
var/phase/type = 21
var/phase/value = &"DORMANT"

[sub_resource type="BTCondition" id="BTCondition_engage"]
custom_name = "Player within awareness range"
script = ExtResource("1_engage")

[sub_resource type="BTAction" id="BTAction_approach"]
custom_name = "Approach until within attack range"
script = ExtResource("2_approach")

[sub_resource type="BTAction" id="BTAction_windup"]
custom_name = "Commit position and wind up"
script = ExtResource("3_windup")

[sub_resource type="BTAction" id="BTAction_strike"]
custom_name = "Strike committed area once"
script = ExtResource("4_strike")

[sub_resource type="BTAction" id="BTAction_recover"]
custom_name = "Recover after hit or miss"
script = ExtResource("5_recover")

[sub_resource type="BTSequence" id="BTSequence_attack"]
custom_name = "Committed melee cycle"
children = [SubResource("BTCondition_engage"), SubResource("BTAction_approach"), SubResource("BTAction_windup"), SubResource("BTAction_strike"), SubResource("BTAction_recover")]

[sub_resource type="BTAction" id="BTAction_idle"]
custom_name = "Idle outside awareness range"
script = ExtResource("6_idle")

[sub_resource type="BTSelector" id="BTSelector_root"]
custom_name = "Final Enemy"
children = [SubResource("BTSequence_attack"), SubResource("BTAction_idle")]

[resource]
blackboard_plan = SubResource("BlackboardPlan_ai")
root_task = SubResource("BTSelector_root")
