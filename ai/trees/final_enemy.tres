max_duration = 0.8

[sub_resource type="BTSequence" id="BTSequence_reaction"]
custom_name = "Interrupted by qualifying hit"
children = [SubResource("BTCondition_reacting"), SubResource("BTAction_reaction"), SubResource("BTRandomWait_0aqjg")]

[sub_resource type="BTCondition" id="BTCondition_engage"]
custom_name = "Player within awareness range"
script = ExtResource("1_engage")

[sub_resource type="BTAction" id="BTAction_approach"]
custom_name = "Approach until within attack range"
script = ExtResource("2_approach")

[sub_resource type="BTAction" id="BTAction_windup"]
custom_name = "Commit position and wind up"
script = ExtResource("3_windup")

[sub_resource type="BTAction" id="BTAction_strike"]
custom_name = "Strike committed area once"
script = ExtResource("4_strike")

[sub_resource type="BTAction" id="BTAction_recover"]
custom_name = "Play authored recovery to animation end"
script = ExtResource("5_recover")

[sub_resource type="BTRandomWait" id="BTRandomWait_t33y5"]
min_duration = 0.3
max_duration = 0.8

[sub_resource type="BTSequence" id="BTSequence_attack"]
custom_name = "Committed melee cycle"
